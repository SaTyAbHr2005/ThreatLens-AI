# Copy to .env and fill in. Never commit .env.

ENV=dev

# --- Database: MongoDB Atlas (free M0 cluster) ---
# Atlas → Connect → Drivers → copy the connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=threatlens

# --- Tokens ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=change-me

# --- Agents ---
AGENT_MODE=replay

# --- Free LLM providers (all optional) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
# Comma-separated free model ids from openrouter.ai/models (filter: free)
OPENROUTER_MODELS=minimax/minimax-m3.1-flash:free,nvidia/nemotron-3.5-super-vl:free
OLLAMA_URL=
OLLAMA_MODEL=llama3.1

# --- Optional services ---
ML_SERVICE_URL=
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
CORS_ORIGINS=http://localhost:5173
FAIL_MODE_SENSITIVE=closed


ADMIN_API_KEY=

# --- Console login (analysts) ---
# The demo analyst account is created at startup when both are set (password >= 12 chars in prod).
DEMO_ANALYST_EMAIL=
DEMO_ANALYST_PASSWORD=
RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT_PER_MIN=20